# Server Configuration
PORT=3000

# Meta / Facebook Messenger Webhook & Graph API
PAGE_ACCESS_TOKEN=your_facebook_page_access_token
VERIFY_TOKEN=your_custom_webhook_verify_token
APP_SECRET=your_facebook_app_secret
FB_PAGE_ID=your_facebook_page_id
GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=your_permanent_meta_access_token

# AI Models & Keys
# Gemini API Keys — comma-separated, one per Google Cloud project
# Uses round-robin rotation to distribute calls across keys.
# Fallback: if GEMINI_API_KEYS is not set, reads single GEMINI_API_KEY instead.
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10,key11,key12,key13,key14,key15
GEMINI_MODEL=models/gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
BOT_SYSTEM_PROMPT="Ikaw ay Tagalog assistant, I'm replying to customers in Tagalog, Keep replies friendly and under 300 characters."

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Internal Auth & Operations
INTERNAL_API_KEY=generate_a_secure_random_api_key_here
SCRAPER_INTERVAL_SECONDS=300

# Messenger Sync — polls the Graph API to detect unsent/deleted messages
# Set interval in seconds (minimum 30). Default: 300 (every 5 minutes).
MESSENGER_SYNC_INTERVAL_SECONDS=300
